{
    // Param-matched LNO Darcy variant, requested 2026-09-24 to make the
    // Darcy table's LNO comparison capacity-fair (LNO_Darcy.jsonc is
    // 762,113 params, vs. LTO's much smaller 29,139 plain-kernel /
    // 28,894 attn-only configs) -- same idea as
    // configs/LNO_time_NS2d_small.jsonc for NS2d.
    //
    // n_block=3/n_mode=128/n_dim=26/n_head=2 -- the closest grid point
    // found by find_lno_param_config_darcy.py's search (real
    // module.model.LNO instances, params counted directly, not
    // hand-derived), refined with a finer grid centered on the coarse
    // search's best region:
    //   python find_lno_param_config_darcy.py --target 29139 --n_dim_grid "16,18,20,22,24,26,28,30,32" --n_block_grid "2,3,4,5" --n_mode_grid "32,48,64,80,96,128" --n_head_grid "1,2"
    // Result: 29,171 params -- +0.11% over LTO's plain-kernel baseline
    // (29,139) and +0.96% over LTO's attn-only baseline (28,894, close
    // enough that one matched LNO config serves both comparisons).
    // n_head doesn't move the param count for this architecture (pure
    // reshape of the same projections) -- 2 was picked arbitrarily from
    // the tied options.
    //
    // n_layer/attn/act/loss/optimizer/scheduler/train all identical to
    // LNO_Darcy.jsonc (the natural-size 762,113-param config, kept as
    // the Darcy-consistent comparison) -- only the model's capacity
    // knobs changed.
    "data": {
        "name": "Darcy",
        "train_batch_size" : 4,
        "val_batch_size": 4
    },
    "model": {
        "name": "LNO",
        "n_block": 3,
        "n_mode": 128,
        "n_dim" : 26,
        "n_head" : 2,
        "n_layer": 2,
        "attn": "Attention_Vanilla",
        "act": "GELU"
    },
    "loss": {
        "name": "rL2"
    },
    "optimizer": {
        "name": "AdamW",
        "lr": 1e-3,
        "weight_decay": 0.00005,
        "beta0": 0.9,
        "beta1": 0.99
    },
    "scheduler": {
        "name": "OneCycle",
        "div_factor": 1e4,
        "final_div_factor": 1e4,
        "pct_start": 0.2
    },
    "train":{
        "epoch": 500,
        "log_print_interval_epoch": 1,
        "model_save_interval_epoch": 50,
        "grad_clip": 1000.0
    }
}
